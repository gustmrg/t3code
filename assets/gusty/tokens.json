  "dark": {
    "background": "#0B1020",
    "surface": "#111A2E",
    "text": "#E5E7EB",
    "muted": "#94A3B8",
    "link": "#60A5FA",
    "borderSubtle": "#334155",
    "borderControl": "#64748B",
    "action": "#2563EB",
